<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <!-- Dateien / Historie / Einstellungen -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_height"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnChoose"
            style="@style/IconButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/cd_choose"
            android:src="@drawable/ic_folder" />

        <ImageButton
            android:id="@+id/btnHistory"
            style="@style/IconButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/cd_history"
            android:src="@drawable/ic_history" />

        <ImageButton
            android:id="@+id/btnSettings"
            style="@style/IconButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/cd_settings"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/no_track"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Zeitleiste: Schieberegler + Marker-/Ausschnittsleiste; beide reagieren auf Touch -->
    <SeekBar
        android:id="@+id/seek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="4dp"
        android:progressDrawable="@drawable/seek_track"
        android:splitTrack="false"
        android:thumb="@drawable/seek_thumb" />

    <app.uebungsplayer.TimelineView
        android:id="@+id/timeline"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp" />

    <TextView
        android:id="@+id/time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:gravity="center"
        android:text="0:00 / 0:00"
        android:textSize="16sp" />

    <!-- Transport -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/control_height"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnPrev"
            style="@style/IconButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/cd_prev"
            android:src="@drawable/ic_prev" />

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/IconButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/cd_rew"
            android:src="@drawable/ic_rew" />

        <ImageButton
            android:id="@+id/btnPlay"
            style="@style/IconButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/cd_play"
            android:src="@drawable/ic_play" />


        <ImageButton
            android:id="@+id/btnFwd"
            style="@style/IconButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/cd_ffwd"
            android:src="@drawable/ic_ffwd" />

        <ImageButton
            android:id="@+id/btnNext"
            style="@style/IconButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/cd_next"
            android:src="@drawable/ic_next" />
    </LinearLayout>

    <TextView
        android:id="@+id/headSpeed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:text="@string/head_speed"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Tempo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/control_height"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnSpeedMinus"
            style="@style/IconButton"
            android:layout_width="56dp"
            android:layout_height="match_parent"
            android:contentDescription="@string/cd_speed_minus"
            android:padding="14dp"
            android:src="@drawable/ic_minus" />

        <SeekBar
            android:id="@+id/speedSeek"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:max="75"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:progressDrawable="@drawable/seek_track"
            android:splitTrack="false"
            android:thumb="@drawable/seek_thumb" />

        <ImageButton
            android:id="@+id/btnSpeedPlus"
            style="@style/IconButton"
            android:layout_width="56dp"
            android:layout_height="match_parent"
            android:contentDescription="@string/cd_speed_plus"
            android:padding="14dp"
            android:src="@drawable/ic_plus" />

        <LinearLayout
            android:id="@+id/btnSpeedReset"
            android:layout_width="84dp"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/cd_speed_reset"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_reset"
                android:tint="?android:attr/textColorPrimary" />

            <TextView
                android:id="@+id/speedValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100 %"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/headSet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:text="@string/head_set"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Ausschnitt / Marker / Schleife -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/control_height"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnSegment"
            style="@style/IconButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/cd_seg_start"
            android:src="@drawable/ic_seg_set_base" />

        <ImageButton
            android:id="@+id/btnMarker"
            style="@style/IconButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/cd_marker"
            android:src="@drawable/ic_marker_add" />

        <ImageButton
            android:id="@+id/btnLoop"
            style="@style/IconButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/cd_loop"
            android:src="@drawable/ic_loop" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/emptyList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="16dp"
            android:text="@string/no_items" />
    </FrameLayout>
</LinearLayout>
