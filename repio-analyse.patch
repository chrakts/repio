--- a/app/src/main/java/app/uebungsplayer/AnalysisPanel.kt	1970-01-01 00:00:00.000000000 +0000
+++ b/app/src/main/java/app/uebungsplayer/AnalysisPanel.kt	2026-10-24 13:23:54.864113255 +0000
